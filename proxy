#!/usr/bin/env bash
# proxy — a portable, self-contained CLI for managing the mihomo (Clash.Meta) core.
#
# All code lives in this directory (~/scripts/proxy/). Nothing is written elsewhere
# except: a one-line pointer hook appended to ~/.bashrc (not code), and runtime
# state under ~/.config/mihomo/. Designed to be cloned from GitHub and work on a
# fresh machine: it detects/downloads mihomo, bootstraps config, and never assumes
# sudo, an existing binary, or pre-existing config files.
#
# Usage: proxy <command> [args...]
#   install/init   set mihomo up (detect → brew → GitHub download)
#   start|stop|restart|status|log   lifecycle
#   env on|off     toggle proxy env vars in the current shell (via .bashrc hook)
#   node list|test|use   pick/switch exit nodes (controller API)
#   merge list|add|rm|diff|apply   manage prepend rules (safe: validate then reload)
#   region list|apply|add|rm|set   region auto-groups (fallback sticky, HK excluded, 60s checks)
#   sub add|rm|list|use|show|refresh   multi-subscription management (refresh re-applies merge)
#   tun on|off|--setup-nopasswd   transparent TUN (needs root)
#   check          system proxy & connectivity check
#   route <URL>    test proxy vs direct reachability for a URL
#   monitor        live traffic monitor (controller /connections, auto-refresh)
#   ui [on|off]    Web dashboard (metacubexd); on = bind 0.0.0.0 + secret (LAN-accessible)
#   doctor         environment health check
#   upgrade|uninstall
set -o pipefail

# --- resolve this script's real dir (follow the ~/.local/bin symlink) ---
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/detect.sh
source "$SCRIPT_DIR/lib/detect.sh"

load() { # load <module-name>  -> sources lib/<name>.sh
    local f="$SCRIPT_DIR/lib/$1.sh"
    [[ -f "$f" ]] || die "内部错误: 缺少模块 $1 ($f)"
    # shellcheck source=/dev/null
    source "$f"
}

usage() {
    local w=48 n="${C_N}"
    printf '%sproxy%s — mihomo (Clash.Meta) 管理 CLI\n\n' "${C_B}${C_Y}" "$n"

    printf '  %s📦 安装%s\n' "${C_B}" "$n"
    printf '  %-*s %s\n' "$w" "install [--via github|brew|gz] [--bin PATH]" "检测/下载 mihomo + 引导配置 + 装钩子"
    printf '  %-*s %s\n' "$w" "init" "仅初始化配置 + 钩子 (已有二进制)"
    printf '  %-*s %s\n' "$w" "upgrade" "升级 mihomo"
    printf '  %-*s %s\n' "$w" "uninstall" "移除钩子/软链 (配置保留)"
    printf '\n'

    printf '  %s🚀 运行%s\n' "${C_B}" "$n"
    printf '  %-*s %s\n' "$w" "start | stop | restart" "启停 (nohup 直连二进制, brew 感知)"
    printf '  %-*s %s\n' "$w" "status" "运行/版本/出口节点/流量/端口/TUN/代理环境 + 自动诊断"
    printf '  %-*s %s\n' "$w" "log [-f]" "日志 (-f 跟随)"
    printf '\n'

    printf '  %s🌍 节点 / 订阅%s\n' "${C_B}" "$n"
    printf '  %-*s %s\n' "$w" "node list | test | use" "节点列表 / 测延迟后直切 / 模糊切换"
    printf '  %-*s %s\n' "$w" "region list | apply | preset | add | rm | set" "地区自动组 (HK/SG/JP/US 一键预设)"
    printf '  %-*s %s\n' "$w" "sub add | rm | list | use | show | refresh" "多订阅管理 (refresh 自动重放 merge)"
    printf '  %-*s %s\n' "$w" "merge list | add | rm | diff | apply" "前置规则管理 (校验通过才生效)"
    printf '  %-*s %s\n' "$w" "tun on | off [--setup-nopasswd]" "透明 TUN (需 root)"
    printf '\n'

    printf '  %s🧰 工具%s\n' "${C_B}" "$n"
    printf '  %-*s %s\n' "$w" "env on | off | show" "代理环境变量 (当前 shell 无感生效)"
    printf '  %-*s %s\n' "$w" "check" "系统代理 + 外网连通性检查"
    printf '  %-*s %s\n' "$w" "route <URL> [--json]" "路由检测: 代理 vs 直连对比延迟"
    printf '  %-*s %s\n' "$w" "monitor [--interval 秒] [--sort down|up] [--once]" "实时流量监控 (Ctrl-C 退出)"
    printf '  %-*s %s\n' "$w" "ui [--secret [VALUE]] | off | status" "Web 仪表盘 (局域网访问)"
    printf '  %-*s %s\n' "$w" "lan on | off | status" "allow-lan 开关 (局域网设备代理, 订阅刷新后保留)"
    printf '  %-*s %s\n' "$w" "pool on | off | status | refresh" "节点池模式: 全机场节点归一化合并 + 无感自动切换"
    printf '  %-*s %s\n' "$w" "sync export | import | push | pull" "多端同步 merge/region/订阅/设置 (对标 scripts secret)"
    printf '  %-*s %s\n' "$w" "doctor" "环境体检"
    printf '\n'

    printf '%s运行 %sproxy <command> -h%s 查看子命令详情 · 项目: %s~/scripts/proxy/%s\n' \
        "${C_D}" "${C_B}" "$n" "${C_D}" "$n"
}

cmd=$1; shift || true
case $cmd in
    install)        load install; proxy_install "$@" ;;
    init)           load install; proxy_init "$@" ;;
    doctor)         load install; proxy_doctor "$@" ;;
    upgrade)        load install; proxy_upgrade "$@" ;;
    uninstall)      load install; proxy_uninstall "$@" ;;

    start)          load service; svc_start "$@" ;;
    stop)           load service; svc_stop "$@" ;;
    restart)        load service; svc_restart "$@" ;;
    status)         load service; svc_status "$@" ;;
    log)            load service; svc_log "$@" ;;

    env)            load env; env_cmd "$@" ;;

    node)           load node; node_cmd "$@" ;;
    merge)          load merge; merge_cmd "$@" ;;
    region)         load region; region_cmd "$@" ;;
    sub)            load sub; sub_cmd "$@" ;;
    tun)            load tun; tun_cmd "$@" ;;
    check)          load check; proxy_check "$@" ;;
    route)          load route; route_cmd "$@" ;;
    monitor)        load monitor; monitor_cmd "$@" ;;
    ui)             load ui; ui_cmd "$@" ;;
    lan)            load lan; lan_cmd "$@" ;;
    pool)           load pool; pool_cmd "$@" ;;
    sync)           load sync; sync_cmd "$@" ;;

    _login)         load env; env_login ;;     # internal: called by .bashrc hook

    -h|--help|help|"") usage ;;
    *) die "未知命令: $cmd (运行 proxy 查看帮助)" ;;
esac
